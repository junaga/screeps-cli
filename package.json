{
  "name": "screeps-terminal",
  "version": "0.2.0",
  "description": "Play Screeps World from the terminal",
  "type": "module",
  "bin": {
    "screeps": "./bin.js"
  },
  "files": [
    "bin.js",
    "src/",
    "docs/manifest.json",
    "docs/pages/"
  ],
  "scripts": {
    "test": "node --test",
    "docs:update": "node docs/update.js",
    "check": "node --check bin.js && node --check src/*.js && node --check docs/*.js && node --test"
  },
  "engines": {
    "node": "22.x || 24.x"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "screeps-api": "^2.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "parse5": "^8.0.1"
  }
}
